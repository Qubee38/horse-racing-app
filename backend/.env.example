# データベース設定
# 開発環境: SQLite（プロジェクトルートのdata/配下）
DATABASE_URL=sqlite:///../data/horse_racing.db

# 本番環境: PostgreSQL（使用する場合）
# DATABASE_URL=postgresql://user:password@host:5432/database

# 本番環境: SQLite（Renderの場合）
# DATABASE_URL=sqlite:////opt/render/project/src/data/horse_racing.db

# Anthropic Claude API
# https://console.anthropic.com/settings/keys から取得
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# 環境設定
# development, production
ENVIRONMENT=development

# CORS設定（カンマ区切りで複数指定可能）
# 開発環境
ALLOWED_ORIGINS=http://localhost:3000

# 本番環境（例）
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# データベース設定（オプション）
DB_ECHO=True  # SQL実行ログ表示（developmentのみ推奨）

# AI解説設定のプレフィックス（変更不要）
AI_COMMENTARY_PREFIX=AI_COMMENTARY_